# Токен бота от @BotFather
BOT_TOKEN=1234567890:AAH...

# Публичный HTTPS-адрес, где запущен этот сервер (Telegram открывает Mini App только по HTTPS)
WEBAPP_URL=https://burgerlab.example.com

# ID группы кухни, куда приходят заказы с кнопками этапов (узнать: добавьте бота в группу и отправьте /chatid)
KITCHEN_CHAT_ID=

# Telegram user ID администраторов через запятую (им доступны /today и кнопки заказов; если нет группы кухни — заказы приходят им)
ADMIN_IDS=

# Короткое имя Mini App из @BotFather (/newapp), если создавали. Можно оставить пустым
APP_NAME=

# Касса и админ-панель (адрес /staff): первый администратор создаётся при первом запуске.
# Если пароль не указан, он будет сгенерирован и выведен в консоль один раз.
STAFF_ADMIN_LOGIN=admin
STAFF_ADMIN_PASSWORD=

# Секрет для подписи входа сотрудников (необязательно: по умолчанию выводится из BOT_TOKEN)
STAFF_SECRET=

PORT=3000
TZ=Asia/Tashkent
